# ====== Check parameters ===================================================
if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ] ; then
   echo >&2 "Usage: $0 [Simulation] [Destination Directory]"
   exit 1
fi

TOOLCHAIN_DIRECTORY="$(cd "$(dirname "$0")" && pwd -P)"

SIMULATION="${1%/}"
if [ $# -gt 1 ] ; then
   DESTINATION="${2%/}"
   [ -z "$DESTINATION" ] && DESTINATION="/"
else
   DESTINATION="."
fi


# ====== Step 1: Plot and archive results only ==============================
echo "Step 1: Archiving results only to $DESTINATION/$SIMULATION.tar.bz2 ..."
"$TOOLCHAIN_DIRECTORY/archive-simulation" "$SIMULATION" "$DESTINATION"


# ====== Step 2: Archive everything =========================================
echo "Step 2: Archiving everything to $DESTINATION/$SIMULATION-complete.tar.bz2 ..."
tar cf - "$SIMULATION.R" "plot-$SIMULATION.R" "$SIMULATION.pdf" "$SIMULATION" | bzip2 >"$DESTINATION/$SIMULATION-complete.tar.bz2"
