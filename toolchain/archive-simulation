# ====== Check parameters ===================================================
if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ] ; then
   echo >&2 "Usage: $0 [Simulation] [Destination Directory]"
   exit 1
fi

SIMULATION="${1%/}"
case "$SIMULATION" in
   ""|-*)
      echo >&2 "ERROR: Invalid simulation name $1!"
      exit 1
      ;;
esac

if [ $# -gt 1 ] ; then
   DESTINATION="${2%/}"
   [ -z "$DESTINATION" ] && DESTINATION="/"
else
   DESTINATION="."
fi

if [ ! -f "$SIMULATION.R" ] ; then
   echo >&2 "ERROR: $SIMULATION.R does not exist!"
   exit 1
fi
if [ ! -f "plot-$SIMULATION.R" ] ; then
   echo >&2 "ERROR: plot-$SIMULATION.R does not exist!"
   exit 1
fi
if [ ! -d "$SIMULATION" ] ; then
   echo >&2 "ERROR: $SIMULATION directory does not exist!"
   exit 1
fi
if [ ! -d "$SIMULATION/Results" ] ; then
   echo >&2 "ERROR: $SIMULATION/Results directory does not exist!"
   exit 1
fi
if [ ! -d "$DESTINATION" ] ; then
   echo >&2 "ERROR: Destination directory $DESTINATION does not exist!"
   exit 1
fi


# ====== Plot and archive results ===========================================
echo "Archiving to $DESTINATION/$SIMULATION.tar.bz2 ..."
R --vanilla <"plot-$SIMULATION.R"
tar cf - "$SIMULATION.R" "plot-$SIMULATION.R" "$SIMULATION.pdf" "$SIMULATION/Results" | bzip2 >"$DESTINATION/$SIMULATION.tar.bz2"
