# ====== Check parameters ===================================================
if [ $# -lt 4 ] ; then
   echo >&2 "Usage: $0 [Simulation Directory] [Run Directory] [.ini File Name] [Pool Handle] {Misc Options to PU} {XML File Name}"
   exit 1
fi

if [ ! -d "$1" ] ; then
   echo >&2 "ERROR: Simulation directory $1 does not exist!"
   exit 1
fi
if [ ! -d "$2" ] ; then
   echo >&2 "ERROR: Run directory $2 does not exist!"
   exit 1
fi

TOOLCHAIN_DIRECTORY="$(cd -- "$(dirname -- "$0")" && pwd -P)"
SIM_DIRECTORY="$(cd -- "$1" && pwd -P)"
TMP_DIRECTORY="$SIM_DIRECTORY/Temp"
RUN_DIRECTORY="$(cd -- "$2" && pwd -P)"
INI_NAME="$3"
POOLHANDLE="$4"
PU_MISCOPT=""
XML_NAME=""
if [ $# -ge 5 ] ; then
   PU_MISCOPT="$5"
fi
if [ $# -ge 6 ] ; then
   XML_NAME="$6"
fi
MAX_RETRIES=10                   # After a remote-side error, retry how many times?


# ###########################################################################
# Settings for running the simulation:
#  - SIMULATION_ENVIRONMENT sets tar.bz2 file containing environment
#       (this file should contain simulation.config-stage0)
#  - SIMULATION_CONFIGS sets simulation.config-stageX files to be included
#       (ssrun will execute them in alphabetical order, beginning with stage 0)
#  - SIMULATION_POOLUSER sets the Scripting PU program (including path)
#
SIMULATION_ENVIRONMENT="simulation-environment.tar.bz2"
SIMULATION_CONFIGS=""   # "simulation.config-stage1"
if [ -z "${SIMULATION_POOLUSER:-}" ] ; then
   if command -v scriptingclient >/dev/null 2>&1 ; then
      SIMULATION_POOLUSER="$(command -v scriptingclient)"
   else
      SIMULATION_POOLUSER="/usr/bin/scriptingclient"
   fi
fi
# ###########################################################################

UNIQUE_ID="$2/$INI_NAME"
PU_LOGFILE="$RUN_DIRECTORY/$INI_NAME.log"
PU_LOGLEVEL=2
VALGRIND=
#VALGRIND="valgrind  -v --tool=memcheck --leak-check=yes --show-reachable=no --leak-resolution=high --num-callers=40 --freelist-vol=4000000"
#VALGRIND="valgrind" #  -v --tool=helgrind"


# ====== Prepare temporary file names =======================================
if [ ! -x "$SIMULATION_POOLUSER" ] ; then
   echo >&2 "==================================================="
   echo >&2 "ERROR: Unable to find executable PU program at $SIMULATION_POOLUSER!"
   echo >&2 "==================================================="
   exit 1
fi
if [ ! -f "$RUN_DIRECTORY/$INI_NAME" ] ; then
   echo >&2 "ERROR: INI file $RUN_DIRECTORY/$INI_NAME does not exist!"
   exit 1
fi
if [ -n "$XML_NAME" ] && [ ! -f "$RUN_DIRECTORY/$XML_NAME" ] ; then
   echo >&2 "ERROR: XML file $RUN_DIRECTORY/$XML_NAME does not exist!"
   exit 1
fi

mkdir -p -- "$TMP_DIRECTORY"
INPUT_ARCHIVE="$(mktemp "$TMP_DIRECTORY/input-XXXXXXXXXX")"
OUTPUT_ARCHIVE="$(mktemp "$TMP_DIRECTORY/output-XXXXXXXXXX")"
STAGE_DIR="$(mktemp -d "$TMP_DIRECTORY/stage-XXXXXXXXXX")"
trap 'rm -rf -- "$INPUT_ARCHIVE" "$OUTPUT_ARCHIVE" "$STAGE_DIR"' EXIT


# ====== Create input archive ===============================================
echo "Preparing input [$UNIQUE_ID] ..."
mkdir -p -- "$STAGE_DIR/in"
cp -p -- "$TOOLCHAIN_DIRECTORY/ssrun" "$STAGE_DIR/in/"
for cfg in $SIMULATION_CONFIGS ; do
   if [ -f "$cfg" ] ; then
      cp -p -- "$cfg" "$STAGE_DIR/in/"
   elif [ -f "$SIM_DIRECTORY/$cfg" ] ; then
      cp -p -- "$SIM_DIRECTORY/$cfg" "$STAGE_DIR/in/"
   else
      echo >&2 "ERROR: Configuration file $cfg not found!"
      exit 1
   fi
done
cp -p -- "$RUN_DIRECTORY/$INI_NAME" "$STAGE_DIR/in/"
if [ -n "$XML_NAME" ] ; then
   cp -p -- "$RUN_DIRECTORY/$XML_NAME" "$STAGE_DIR/in/"
fi

# Using "nice" here, since there may be many sessions ...
( cd -- "$STAGE_DIR/in" && nice tar chf - . | gzip >"$INPUT_ARCHIVE" )


# ====== Start PU for job distribution ======================================
echo "Distributing and processing [$UNIQUE_ID] ..."
# Not using "nice" here, in order to ensure quick upload/download ...
# NOTE: At least rsplib 2.7.6 is required!
RESULT=0
# shellcheck disable=SC2086
if $VALGRIND "$SIMULATION_POOLUSER" \
      -runid="$UNIQUE_ID" -quiet -maxretry="$MAX_RETRIES" \
      -environment="$SIM_DIRECTORY/$SIMULATION_ENVIRONMENT" \
      -input="$INPUT_ARCHIVE" -output="$OUTPUT_ARCHIVE" \
      -logfile="$PU_LOGFILE" -loglevel="$PU_LOGLEVEL" \
      -poolhandle="$POOLHANDLE" \
      $PU_MISCOPT ; then
   RESULT=0
else
   RESULT=$?
fi

if [ -e "$PU_LOGFILE" ] ; then
   bzip2 -f -- "$PU_LOGFILE"
fi


# ====== Extract results archive ============================================
echo "Extracting [$UNIQUE_ID] ..."
if [ ! -s "$OUTPUT_ARCHIVE" ] ; then
   echo >&2 "==================================================="
   echo >&2 "ERROR: No results have been created in directory $RUN_DIRECTORY!"
   echo >&2 "==================================================="
   exit 1
fi

# Using "nice" here, since there may be many sessions ...
mkdir -p -- "$STAGE_DIR/out"
gzip -dc -- "$OUTPUT_ARCHIVE" | ( cd -- "$STAGE_DIR/out" && nice tar xf - )
find "$STAGE_DIR/out" -type f -exec touch {} +
(
   cd -- "$STAGE_DIR/out" &&
   find . -type d -exec sh -c '
      dest="$1"
      shift
      for d do
         mkdir -p -- "$dest/$d" || exit 1
      done
   ' sh "$RUN_DIRECTORY" {} + &&
   find . ! -type d -exec sh -c '
      dest="$1"
      shift
      for f do
         mv -f -- "$f" "$dest/$f" || exit 1
      done
   ' sh "$RUN_DIRECTORY" {} +
)


# ====== Print error, if run has not been completed successfully ============
if [ "$RESULT" -ne 0 ] ; then
   OUTPUT_NAME="${INI_NAME%-parameters.ini}-output.txt.bz2"
   {
      echo ""
      echo "----- SIMULATION RUN FAILED (exit code $RESULT) -----"
      echo ""
      if [ -e "$RUN_DIRECTORY/$OUTPUT_NAME" ] ; then
         echo "#########################################################"
         bzip2 -dc -- "$RUN_DIRECTORY/$OUTPUT_NAME" | grep "^<!> Error " || true
         echo "#########################################################"
         echo ""
      fi
      echo "INI file:    $RUN_DIRECTORY/$INI_NAME"
      echo "Output file: $RUN_DIRECTORY/$OUTPUT_NAME"
      echo "----- SIMULATION RUN FAILED -----"
   } >&2
fi

exit "$RESULT"
