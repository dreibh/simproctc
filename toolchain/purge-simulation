# ====== Check parameters ===================================================
if [ $# -lt 1 ] || [ -z "$1" ] ; then
   echo >&2 "Usage: $0 [Simulation]"
   exit 1
fi

SIMULATION="$1"
if [ ! -d "$SIMULATION" ] ; then
   echo >&2 "ERROR: Directory $SIMULATION does not exist!"
   exit 1
fi
if [ ! -f "$SIMULATION/dependencies.list" ] ; then
   echo >&2 "ERROR: $SIMULATION/dependencies.list does not exist!"
   exit 1
fi

cd -- "$SIMULATION"


# ====== Find obsolete runs =================================================
echo "Finding obsolete runs ..."
purgeList="$(mktemp "${TMPDIR:-/tmp}/purge.XXXXXXXXXX")"
trap 'rm -f -- "$purgeList"' EXIT

if [ -d "Simulations" ] ; then
   find Simulations -type f -name "run[0-9]*-*" | awk '
      NR == FNR {
         if (NF > 0) {
            keep[$0] = 1
         }
         next
      }
      {
         if (match($0, /\/run[0-9]+-/)) {
            prefix = substr($0, 1, RSTART + RLENGTH - 2)
            if (!(prefix in keep)) {
               print $0
            }
         }
      }
   ' dependencies.list - >"$purgeList"
fi


# ====== Remove obsolete runs ===============================================
echo "Removing obsolete runs ..."
while IFS= read -r obsoleteFile ; do
   [ -n "$obsoleteFile" ] && rm -f -- "$obsoleteFile"
done <"$purgeList"

if [ -d "Simulations" ] ; then
   for dir in Simulations/* ; do
      if [ -d "$dir" ] ; then
         rmdir -- "$dir" 2>/dev/null || true
      fi
   done
   find Simulations -name "Shortcut-*" -exec rm -f {} +
fi

rm -f -- purge.list purge.sed make.log


echo "Done!"
