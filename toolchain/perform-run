# ====== Check parameters ===================================================
if [ $# -lt 3 ] ; then
   echo >&2 "Usage: $0 [Simulation Directory] [Run Directory] [Run Number] {Pool Handle} {PU Misc Options}"
   echo >&2 "Example: $0   test1 test1/Simulations/Set-1234 1   ScriptingPool \"-cspserver=127.0.0.1\""
   exit 1
fi

if [ ! -d "$1" ] ; then
   echo >&2 "ERROR: Simulation directory $1 does not exist!"
   exit 1
fi
if [ ! -d "$2" ] ; then
   echo >&2 "ERROR: Run directory $2 does not exist!"
   exit 1
fi

TOOLCHAIN_DIRECTORY="$(cd -- "$(dirname -- "$0")" && pwd -P)"
SIMULATION_DIRECTORY="$(cd -- "$1" && pwd -P)"
RUN_DIRECTORY="$(cd -- "$2" && pwd -P)"
RUN_NUMBER="$3"
POOLHANDLE=""
PU_MISCOPT=""
if [ $# -ge 4 ] ; then
   POOLHANDLE="$4"
fi
if [ $# -ge 5 ] ; then
   PU_MISCOPT="$5"
fi


RUN_PREFIX="run$RUN_NUMBER"
STATUS_FILE="$RUN_PREFIX-status.txt"
INI_FILE="$RUN_PREFIX-parameters.ini"
if [ -e "$RUN_DIRECTORY/scenario$RUN_NUMBER.xml" ] ; then
   XML_FILE="scenario$RUN_NUMBER.xml"
else
   XML_FILE=""
fi


# ====== Check whether run still has to be performed ========================
if [ -e "$RUN_DIRECTORY/$STATUS_FILE" ] ; then
   exit 0   # Run has already been processed
fi


echo "Performing run $RUN_PREFIX ..."

# ====== Perform run locally ================================================
if [ "$POOLHANDLE" = "" ] ; then

   # ====== Clone environment ===============================================
   RESULT=0
   RUN_ENVIRONMENT="$RUN_PREFIX-Environment"
   VECTOR_FILE="$RUN_PREFIX-vectors.vec"
   SCALAR_FILE="$RUN_PREFIX-scalars.sca"
   OUTPUT_FILE="$RUN_PREFIX-output.txt"

   echo "+ $(date) Cloning environment ..."
   rm -rf -- "$RUN_DIRECTORY/$RUN_ENVIRONMENT"
   mkdir -p -- "$RUN_DIRECTORY/$RUN_ENVIRONMENT"

   (
      cd -- "$SIMULATION_DIRECTORY/Environment" &&
      find . -type d -exec sh -c '
         dest="$1"
         shift
         for d do
            mkdir -p -- "$dest/$d" || exit 1
         done
      ' sh "$RUN_DIRECTORY/$RUN_ENVIRONMENT" {} + &&
      find . ! -type d -exec sh -c '
         dest="$1"
         shift
         for f do
            if [ -L "$f" ] ; then
               cp -P -- "$f" "$dest/$f" || exit 1
            else
               ln -- "$f" "$dest/$f" 2>/dev/null || cp -p -- "$f" "$dest/$f" || exit 1
            fi
         done
      ' sh "$RUN_DIRECTORY/$RUN_ENVIRONMENT" {} +
   )

   # %%%%%%%%%%%% Same code in perform-run and ssrun %%%%%%%%%%%%%%%%%%%%%%%%

   # ====== Get configuration ===============================================
   echo "+ $(date) Loading configuration (in $SIMULATION_DIRECTORY/Environment) ..."
   echo "   - Running configuration stages:"
   for stage in "$SIMULATION_DIRECTORY"/Environment/simulation.config-stage? ; do
      if [ -f "$stage" ] ; then
         echo "      o Using $stage ..."
         # shellcheck disable=SC1090
         . "$stage"
      fi
   done

   echo "   - Run directory: $RUN_DIRECTORY"
   echo "   - Environment:   $RUN_DIRECTORY/$RUN_ENVIRONMENT"
   echo "      o Simulation base directory: $SIMULATION_BASEDIR"
   echo "      o Simulation libraries:      $SIMULATION_LIBS"
   echo "      o Simulation NED files:      $SIMULATION_NEDS"
   echo "      o Simulation program:        $SIMULATION_PROGRAM"
   nedArgs=""
   for n in $SIMULATION_NEDS ; do
      if [ "$nedArgs" = "" ] ; then
         nedArgs="$n"
      else
         nedArgs="$nedArgs:$n"
      fi
   done

   SIMULATION_ARGS="-u Cmdenv -f $INI_FILE"
   if [ -n "$nedArgs" ] ; then
      SIMULATION_ARGS="$SIMULATION_ARGS -n $nedArgs"
   fi
   echo "      o Simulation arguments:      $SIMULATION_ARGS"


   # ====== Execute binary ==================================================
   echo "+ $(date) Executing simulation run ..."
   EXEC_DIR="$RUN_DIRECTORY/$RUN_ENVIRONMENT/$SIMULATION_BASEDIR"
   mkdir -p -- "$EXEC_DIR"

   if [ ! -e "$EXEC_DIR/$INI_FILE" ] ; then
      ln -- "$RUN_DIRECTORY/$INI_FILE" "$EXEC_DIR/$INI_FILE" 2>/dev/null || \
         cp -p -- "$RUN_DIRECTORY/$INI_FILE" "$EXEC_DIR/$INI_FILE"
   fi
   if [ "$XML_FILE" != "" ] && [ ! -e "$EXEC_DIR/$XML_FILE" ] ; then
      ln -- "$RUN_DIRECTORY/$XML_FILE" "$EXEC_DIR/$XML_FILE" 2>/dev/null || \
         cp -p -- "$RUN_DIRECTORY/$XML_FILE" "$EXEC_DIR/$XML_FILE"
   fi
   if [ ! -e "$EXEC_DIR/$SIMULATION_PROGRAM" ] ; then
      ln -- "$SIMULATION_DIRECTORY/Environment/$SIMULATION_PROGRAM" "$EXEC_DIR/$SIMULATION_PROGRAM" 2>/dev/null || \
         cp -p -- "$SIMULATION_DIRECTORY/Environment/$SIMULATION_PROGRAM" "$EXEC_DIR/$SIMULATION_PROGRAM"
   fi
   if [ ! -e "$EXEC_DIR/$SIMULATION_LIBS" ] ; then
      ln -s -- "$SIMULATION_DIRECTORY/Environment/$SIMULATION_LIBS" "$EXEC_DIR/$SIMULATION_LIBS"
   fi

   workDirectory="$(pwd)"
   cd -- "$EXEC_DIR"

   startTime="$(date)"
   rm -f -- "$RUN_DIRECTORY/$SCALAR_FILE.bz2" "$RUN_DIRECTORY/$VECTOR_FILE.bz2" "$RUN_DIRECTORY/$OUTPUT_FILE.bz2"
   chmod 700 "./$SIMULATION_PROGRAM"

   SYSTEM="$(uname -s)"
   if [ "$SYSTEM" = "Linux" ] && [ -x "$SIMULATION_LIBS/ld-loader.so" ] ; then
      echo "   -> $SIMULATION_LIBS/ld-loader.so --library-path $SIMULATION_LIBS ./$SIMULATION_PROGRAM $SIMULATION_ARGS"
      # shellcheck disable=SC2086
      if "$SIMULATION_LIBS/ld-loader.so" --library-path "$SIMULATION_LIBS" "./$SIMULATION_PROGRAM" $SIMULATION_ARGS >"$OUTPUT_FILE" 2>&1 ; then
         RESULT=0
      else
         RESULT=$?
      fi
   elif [ "$SYSTEM" = "Darwin" ] ; then
      echo "   -> DYLD_LIBRARY_PATH=$SIMULATION_LIBS ./$SIMULATION_PROGRAM $SIMULATION_ARGS"
      # shellcheck disable=SC2086
      if env DYLD_LIBRARY_PATH="$SIMULATION_LIBS${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}" "./$SIMULATION_PROGRAM" $SIMULATION_ARGS >"$OUTPUT_FILE" 2>&1 ; then
         RESULT=0
      else
         RESULT=$?
      fi
   else
      echo "   -> LD_LIBRARY_PATH=$SIMULATION_LIBS ./$SIMULATION_PROGRAM $SIMULATION_ARGS"
      # shellcheck disable=SC2086
      if env LD_LIBRARY_PATH="$SIMULATION_LIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "./$SIMULATION_PROGRAM" $SIMULATION_ARGS >"$OUTPUT_FILE" 2>&1 ; then
         RESULT=0
      else
         RESULT=$?
      fi
   fi

   find . \( -name "$OUTPUT_FILE" -o -name "$VECTOR_FILE" -o -name "$SCALAR_FILE" \) -exec bzip2 -f {} +
   endTime="$(date)"
   if [ "$RESULT" -eq 0 ] ; then
      { echo "Start: $startTime" && echo "End:   $endTime"; } >"$STATUS_FILE"
   fi

   cd -- "$workDirectory"

   # %%%%%%%%%%%% Same code in perform-run and ssrun %%%%%%%%%%%%%%%%%%%%%%%%


   # ====== Save results and clean up =======================================
   echo "+ $(date) Cleaning up ..."
   for f in "$EXEC_DIR"/*.bz2 "$EXEC_DIR"/*.txt ; do
      if [ -f "$f" ] ; then
         mv -f -- "$f" "$RUN_DIRECTORY/"
      fi
   done
   rm -rf -- "$RUN_DIRECTORY/$RUN_ENVIRONMENT"


   # ====== If run has failed: print output for debugging ===================
   if [ "$RESULT" -ne 0 ] ; then
      {
         echo ""
         echo "----- SIMULATION RUN FAILED (exit code $RESULT) -----"
         echo ""
         echo "#########################################################"
         if [ -f "$RUN_DIRECTORY/$OUTPUT_FILE.bz2" ] ; then
            bzip2 -dc -- "$RUN_DIRECTORY/$OUTPUT_FILE.bz2" | grep "^<!> Error " || true
         elif [ -f "$RUN_DIRECTORY/$OUTPUT_FILE" ] ; then
            grep "^<!> Error " "$RUN_DIRECTORY/$OUTPUT_FILE" || true
         fi
         echo "#########################################################"
         echo ""
         echo "INI file:      $RUN_DIRECTORY/$INI_FILE"
         if [ "$XML_FILE" != "" ] ; then
            echo "Scenario file: $RUN_DIRECTORY/$XML_FILE"
         fi
         echo "Output file:   $RUN_DIRECTORY/$OUTPUT_FILE.bz2"
         echo "----- SIMULATION RUN FAILED -----"
      } >&2
   fi

   exit "$RESULT"


# ====== Distribute run into pool ===========================================
else
   exec "$TOOLCHAIN_DIRECTORY/ssdistribute" "$1" "$2" "$INI_FILE" "$POOLHANDLE" "$PU_MISCOPT" "$XML_FILE"
fi
